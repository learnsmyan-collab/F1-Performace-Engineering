"""
Project: Race Stint Monte Carlo & Risk Model
Author: Smyan Aggarwal
Notes: Runs 10k simulations to account for tyre degradation variance 
       and traffic, helping determine the risk threshold for pit windows.
"""

import matplotlib.pyplot as plt
import numpy as np

class StintRiskModel:
    def __init__(self, runs: int = 10000, base_lap_time: float = 90.0, total_laps: int = 20):
        self.runs = runs
        self.base_lap_time = base_lap_time
        self.total_laps = total_laps

    def simulate_stint(self) -> np.ndarray:
        # track temp and traffic make deg unpredictable, so we use normal dist
        mean_deg = 0.12
        sigma = 0.03
        
        deg_samples = np.random.normal(mean_deg, sigma, self.runs)
        
        # non-linear wear accumulation over stint length (deg compounds slightly)
        stint_times = (self.base_lap_time * self.total_laps) + (deg_samples * (self.total_laps ** 1.1))
        return stint_times

    def plot_results(self, outcomes: np.ndarray, filename: str = "monte_carlo_stint.png") -> None:
        plt.figure(figsize=(7, 4))
        plt.hist(outcomes, bins=50, color='#1f77b4', edgecolor='black', alpha=0.85, linewidth=0.6)
        
        # mark median and 90th percentile risk threshold for strategy review
        p50 = np.median(outcomes)
        p90 = np.percentile(outcomes, 90)
        
        plt.axvline(p50, color='forestgreen', linestyle='--', linewidth=1.5, label=f'P50 Median: {p50:.1f}s')
        plt.axvline(p90, color='crimson', linestyle='--', linewidth=1.5, label=f'P90 Risk Line: {p90:.1f}s')

        plt.title('Monte Carlo: Stint Duration & Traffic Risk Spread', fontsize=10, fontweight='bold')
        plt.ylabel('Frequency', fontsize=9)
        plt.xlabel('Total Stint Time (Seconds)', fontsize=9)
        plt.grid(axis='y', linestyle=':', alpha=0.6)
        plt.legend(loc='upper right', fontsize=8)
        plt.tight_layout()
        
        plt.savefig(filename, dpi=300)
        plt.close()

def main():
    print("Running stint simulation model...")
    
    model = StintRiskModel()
    results = model.simulate_stint()
    
    print(f"\n--- Stint Analysis Summary ---")
    print(f"Iterations:         {model.runs:,}")
    print(f"Median Time (P50):  {np.median(results):.2f}s")
    print(f"Worst-Case (P90):   {np.percentile(results, 90):.2f}s")

    model.plot_results(results)
    print("Generated 'monte_carlo_stint.png' successfully.")

if __name__ == "__main__":
    main()
