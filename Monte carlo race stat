import numpy as np
import matplotlib.pyplot as plt

def run_monte_carlo(iterations=10000):
    """
    Simulates race stint performance using Monte Carlo methods to account 
    for real-world variables like tyre degradation and traffic.
    """
    # The tyre deg model. I'm using a normal distribution here because 
    # track surface temp and traffic make wear pretty unpredictable.
    # Using 10k iterations to get a good spread of results—I want to see
    # where the 'worst-case' strategy puts us compared to the 'ideal'.
    mean_deg = 0.12  
    sigma = 0.03     
    
    # We generate a large sample size (10k iterations) to ensure the 
    # statistical spread is reliable, helping us see the probability 
    # distribution of our total stint time.
    stint_variations = np.random.normal(mean_deg, sigma, iterations)
    
    # Storing the results. The goal is to figure out the 'tyre cliff'—
    # that point in the race where we lose more time on old rubber 
    # than we'd gain by pitting for a fresh set.
    total_race_times = 90 + (stint_variations * 20)
    
    return total_race_times

# Run the simulation
outcomes = run_monte_carlo()

# Visualization
plt.figure(figsize=(10, 6))
plt.hist(outcomes, bins=50, color='royalblue', alpha=0.7, edgecolor='black')
plt.title('Monte Carlo: Probability Distribution of Stint Time', fontsize=14)
plt.xlabel('Total Stint Time (seconds)', fontsize=12)
plt.ylabel('Frequency of Outcome', fontsize=12)
plt.grid(axis='y', linestyle='--', alpha=0.5)
plt.show()
plt.grid(axis='y', linestyle='--', alpha=0.5)
plt.show()
