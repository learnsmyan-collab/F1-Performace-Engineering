import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

def simulate_stint(base_time, wear_rate, thermal_factor, laps=25):
    # Model lap times incorporating linear wear and exponential thermal degradation
    lap_nums = np.arange(1, laps + 1)
    thermal_scaling = 0.04
    thermal_exponent = 1.5
    lap_times = base_time + (wear_rate * lap_nums) + (thermal_factor * (lap_nums ** thermal_exponent) * thermal_scaling)
    return pd.DataFrame({'Lap': lap_nums, 'LapTime': lap_times})

def find_crossover(hard_df, soft_df):
    # Locate the exact lap where soft tire performance drops below hard tire baseline
    diff = soft_df['LapTime'] > hard_df['LapTime']
    if diff.any():
        match = soft_df.loc[diff]
        return int(match.iloc[0]['Lap'])
    return None

def main():
    print("Running tire strategy analysis...")
    
    # Track and compound configuration parameters
    track_heat_multiplier = 1.2
    hard = simulate_stint(base_time=91.5, wear_rate=0.03, thermal_factor=0.02 * track_heat_multiplier)
    soft = simulate_stint(base_time=89.8, wear_rate=0.09, thermal_factor=0.07 * track_heat_multiplier)
    
    crossover_lap = find_crossover(hard, soft)
    
    if crossover_lap:
        print(f"Strategy result: Pit window crossover hit at Lap {crossover_lap}")
    else:
        print("Strategy result: Soft tire maintained pace advantage across stint.")
        
    # Generate and save visual output for portfolio asset
    plt.figure(figsize=(8, 4.5))
    plt.plot(hard['Lap'], hard['LapTime'], label='Hard Compound', color='#2b5c8f', linewidth=2)
    plt.plot(soft['Lap'], soft['LapTime'], label='Soft Compound', color='#d9534f', linewidth=2)
    
    if crossover_lap:
        plt.axvline(x=crossover_lap, color='#f0ad4e', linestyle='--', linewidth=1.5, label=f'Optimal Crossover (Lap {crossover_lap})')
        
    plt.title('Compound Degradation & Pit Strategy Crossover', fontsize=11, fontweight='bold')
    plt.xlabel('Stint Lap Number', fontsize=10)
    plt.ylabel('Lap Time (Seconds)', fontsize=10)
    plt.grid(True, linestyle=':', alpha=0.6)
    plt.legend(frameon=True, fontsize=9)
    plt.tight_layout()
    
    output_filename = 'compound_crossover.png'
    plt.savefig(output_filename, dpi=300)
    plt.close()
    print(f"Successfully exported plot to '{output_filename}'.")

if __name__ == '__main__':
    main()
